generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPiloto {
  ACTIVO
  INACTIVO
}

enum EstadoUnidad {
  DISPONIBLE
  EN_RUTA
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum TipoCombustible {
  GASOLINA
  DIESEL
}

model Piloto {
  id                  Int          @id @default(autoincrement())
  codigo              String       @unique @db.VarChar(20)
  nombreCompleto      String       @map("nombre_completo") @db.VarChar(150)
  telefono            String?      @db.VarChar(20)
  numeroLicencia      String       @unique @map("numero_licencia") @db.VarChar(50)
  vencimientoLicencia DateTime     @map("vencimiento_licencia") @db.Date
  estado              EstadoPiloto @default(ACTIVO)
  observaciones       String?
  creadoEn            DateTime     @default(now()) @map("creado_en")
  actualizadoEn       DateTime     @updatedAt @map("actualizado_en")

  registrosDiarios RegistroDiario[]
  movimientosAhorro MovimientoAhorroPiloto[]

  @@map("pilotos")
}

model Unidad {
  id                Int             @id @default(autoincrement())
  numeroUnidad      String          @unique @map("numero_unidad") @db.VarChar(20)
  placa             String          @unique @db.VarChar(20)
  marca             String          @db.VarChar(50)
  modelo            String          @db.VarChar(50)
  anio              Int
  tipoCombustible   TipoCombustible @map("tipo_combustible")
  kilometrajeActual Int             @map("kilometraje_actual")
  intervaloMantenimientoKm Int? @map("intervalo_mantenimiento_km")
  proximoMantenimientoKm   Int? @map("proximo_mantenimiento_km")
  estado            EstadoUnidad    @default(DISPONIBLE)
  observaciones     String?
  creadoEn          DateTime        @default(now()) @map("creado_en")
  actualizadoEn     DateTime        @updatedAt @map("actualizado_en")

  registrosDiarios RegistroDiario[]
  mantenimientos   Mantenimiento[]
  gastos           Gasto[]
  componentes      ComponenteUnidad[]

  @@map("unidades")
}

enum EstadoRegistroDiario {
  PENDIENTE_COMBUSTIBLE
  COMPLETADO
}

enum TipoMovimientoAhorro {
  APORTE_DIARIO
  RETIRO
  AJUSTE_INGRESO
  AJUSTE_EGRESO
}

model RegistroDiario {
  id                 Int                  @id @default(autoincrement())
  pilotoId           Int                  @map("piloto_id")
  unidadId           Int                  @map("unidad_id")
  fecha              DateTime             @db.Date
  kilometrajeInicial Int                  @map("kilometraje_inicial")
  kilometrajeFinal   Int                  @map("kilometraje_final")
  montoLiquidado     Decimal              @map("monto_liquidado") @db.Decimal(12, 2)
  estado             EstadoRegistroDiario @default(PENDIENTE_COMBUSTIBLE)
  observaciones      String?
  creadoEn           DateTime             @default(now()) @map("creado_en")
  actualizadoEn      DateTime             @updatedAt @map("actualizado_en")

  piloto            Piloto             @relation(fields: [pilotoId], references: [id])
  unidad            Unidad             @relation(fields: [unidadId], references: [id])
  cargaCombustible CargaCombustible?
  movimientoAhorro MovimientoAhorroPiloto?

  @@unique([pilotoId, fecha], map: "uq_registros_diarios_piloto_fecha")
  @@unique([unidadId, fecha], map: "uq_registros_diarios_unidad_fecha")
  @@index([fecha])
  @@index([pilotoId])
  @@index([unidadId])
  @@map("registros_diarios")
}

model MovimientoAhorroPiloto {
  id               Int                  @id @default(autoincrement())
  pilotoId         Int                  @map("piloto_id")
  registroDiarioId Int?                 @unique(map: "uq_movimientos_ahorro_registro_diario") @map("registro_diario_id")
  tipo             TipoMovimientoAhorro
  monto            Decimal              @db.Decimal(12, 2)
  descripcion      String?
  creadoEn         DateTime             @default(now()) @map("creado_en")

  piloto        Piloto          @relation(fields: [pilotoId], references: [id], onDelete: Restrict)
  registroDiario RegistroDiario? @relation(fields: [registroDiarioId], references: [id], onDelete: Restrict)

  @@index([pilotoId, creadoEn])
  @@index([tipo])
  @@map("movimientos_ahorro_pilotos")
}

model CargaCombustible {
  id               Int      @id @default(autoincrement())
  registroDiarioId Int      @unique(map: "uq_cargas_combustible_registro_diario") @map("registro_diario_id")
  monto            Decimal  @db.Decimal(12, 2)
  galones          Decimal  @db.Decimal(10, 3)
  precioGalon      Decimal  @map("precio_galon") @db.Decimal(10, 2)
  creadoEn         DateTime @default(now()) @map("creado_en")

  registroDiario RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)

  @@map("cargas_combustible")
}

enum EstadoMantenimiento {
  EN_PROCESO
  FINALIZADO
}

enum EstadoComponenteUnidad {
  INSTALADO
  RETIRADO
}

enum ModoInstalacionComponente {
  INDIVIDUAL
  POSICIONADO
}

enum AccionMantenimientoComponente {
  INSPECCION
  MANTENIMIENTO
  INSTALACION
  RETIRO
  REEMPLAZO
}

model Mantenimiento {
  id            Int                 @id @default(autoincrement())
  unidadId      Int                 @map("unidad_id")
  fechaInicio   DateTime            @map("fecha_inicio") @db.Date
  fechaFin      DateTime?           @map("fecha_fin") @db.Date
  kilometraje   Int
  descripcion   String
  costo         Decimal             @db.Decimal(12, 2)
  estado        EstadoMantenimiento @default(EN_PROCESO)
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  unidad      Unidad                    @relation(fields: [unidadId], references: [id])
  componentes MantenimientoComponente[]

  @@index([unidadId])
  @@index([estado])
  @@map("mantenimientos")
}

model CatalogoComponente {
  id                     Int      @id @default(autoincrement())
  nombre                 String   @db.VarChar(100)
  descripcion            String?
  vidaUtilMesesDefault   Int?     @map("vida_util_meses_default")
  vidaUtilKmDefault      Int?     @map("vida_util_km_default")
  alertaDiasAntesDefault Int      @default(30) @map("alerta_dias_antes_default")
  alertaKmAntesDefault   Int      @default(500) @map("alerta_km_antes_default")
  modoInstalacion        ModoInstalacionComponente @default(INDIVIDUAL) @map("modo_instalacion")
  activo                 Boolean  @default(true)
  creadoEn               DateTime @default(now()) @map("creado_en")
  actualizadoEn          DateTime @updatedAt @map("actualizado_en")

  componentesUnidad ComponenteUnidad[]
  posiciones         PosicionCatalogoComponente[]

  @@index([activo])
  @@map("catalogo_componentes")
}

model PosicionCatalogoComponente {
  id                   Int      @id @default(autoincrement())
  catalogoComponenteId Int      @map("catalogo_componente_id")
  codigo               String   @db.VarChar(60)
  nombre               String   @db.VarChar(100)
  orden                Int      @default(0)
  activo               Boolean  @default(true)
  creadoEn             DateTime @default(now()) @map("creado_en")
  actualizadoEn        DateTime @updatedAt @map("actualizado_en")

  catalogoComponente CatalogoComponente @relation(fields: [catalogoComponenteId], references: [id], onDelete: Restrict)
  componentesUnidad ComponenteUnidad[]

  @@unique([catalogoComponenteId, codigo], map: "uq_posiciones_catalogo_componente_codigo")
  @@index([catalogoComponenteId, activo])
  @@map("posiciones_catalogo_componentes")
}

model ComponenteUnidad {
  id                    Int                     @id @default(autoincrement())
  unidadId              Int                     @map("unidad_id")
  catalogoComponenteId  Int                     @map("catalogo_componente_id")
  posicionCatalogoId    Int?                    @map("posicion_catalogo_id")
  marca                 String?                 @db.VarChar(100)
  modelo                String?                 @db.VarChar(100)
  numeroSerie           String?                 @map("numero_serie") @db.VarChar(120)
  posicion              String?                 @db.VarChar(80)
  cantidad              Int                     @default(1)
  fechaInstalacion      DateTime                @map("fecha_instalacion") @db.Date
  kilometrajeInstalacion Int                    @map("kilometraje_instalacion")
  vidaUtilMeses         Int?                    @map("vida_util_meses")
  vidaUtilKm            Int?                    @map("vida_util_km")
  alertaDiasAntes       Int                     @default(30) @map("alerta_dias_antes")
  alertaKmAntes         Int                     @default(500) @map("alerta_km_antes")
  estado                EstadoComponenteUnidad  @default(INSTALADO)
  fechaRetiro           DateTime?               @map("fecha_retiro") @db.Date
  kilometrajeRetiro     Int?                    @map("kilometraje_retiro")
  motivoRetiro          String?                 @map("motivo_retiro")
  observaciones         String?
  creadoEn              DateTime                @default(now()) @map("creado_en")
  actualizadoEn         DateTime                @updatedAt @map("actualizado_en")

  unidad             Unidad                     @relation(fields: [unidadId], references: [id])
  catalogoComponente CatalogoComponente          @relation(fields: [catalogoComponenteId], references: [id])
  posicionCatalogo   PosicionCatalogoComponente? @relation(fields: [posicionCatalogoId], references: [id], onDelete: Restrict)
  mantenimientos     MantenimientoComponente[]

  @@index([unidadId, estado])
  @@index([catalogoComponenteId])
  @@index([posicionCatalogoId])
  @@index([fechaInstalacion])
  @@map("componentes_unidad")
}

model MantenimientoComponente {
  id                 Int                            @id @default(autoincrement())
  mantenimientoId    Int                            @map("mantenimiento_id")
  componenteUnidadId Int                            @map("componente_unidad_id")
  accion             AccionMantenimientoComponente
  observaciones      String?
  creadoEn           DateTime                       @default(now()) @map("creado_en")

  mantenimiento    Mantenimiento   @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)
  componenteUnidad ComponenteUnidad @relation(fields: [componenteUnidadId], references: [id])

  @@unique([mantenimientoId, componenteUnidadId, accion], map: "uq_mantenimientos_componentes_accion")
  @@index([mantenimientoId])
  @@index([componenteUnidadId])
  @@map("mantenimientos_componentes")
}

enum TipoGasto {
  REPUESTOS_MENORES
  PINCHAZO
}

enum RolUsuario {
  SUPERADMIN
  DUENO
}

model Usuario {
  id             Int        @id @default(autoincrement())
  nombreCompleto String     @map("nombre_completo") @db.VarChar(150)
  correo         String     @unique @db.VarChar(150)
  contrasenaHash String     @map("contrasena_hash") @db.VarChar(255)
  rol            RolUsuario
  activo         Boolean    @default(true)
  ultimoAccesoEn DateTime?  @map("ultimo_acceso_en")
  creadoEn       DateTime   @default(now()) @map("creado_en")
  actualizadoEn  DateTime   @updatedAt @map("actualizado_en")

  @@index([rol])
  @@index([activo])
  @@map("usuarios")
}

model Gasto {
  id          Int       @id @default(autoincrement())
  unidadId    Int       @map("unidad_id")
  fecha       DateTime  @db.Date
  tipo        TipoGasto
  descripcion String?
  monto       Decimal   @db.Decimal(12, 2)
  creadoEn    DateTime  @default(now()) @map("creado_en")

  unidad Unidad @relation(fields: [unidadId], references: [id])

  @@index([unidadId])
  @@index([fecha])
  @@index([tipo])
  @@map("gastos")
}
