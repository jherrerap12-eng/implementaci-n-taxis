generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoPiloto {
  ACTIVO
  INACTIVO
}

enum EstadoUnidad {
  DISPONIBLE
  EN_RUTA
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum TipoCombustible {
  GASOLINA
  DIESEL
}

model Piloto {
  id                  Int          @id @default(autoincrement())
  codigo              String       @unique @db.VarChar(20)
  nombreCompleto      String       @map("nombre_completo") @db.VarChar(150)
  telefono            String?      @db.VarChar(20)
  numeroLicencia      String       @unique @map("numero_licencia") @db.VarChar(50)
  vencimientoLicencia DateTime     @map("vencimiento_licencia") @db.Date
  estado              EstadoPiloto @default(ACTIVO)
  observaciones       String?
  creadoEn            DateTime     @default(now()) @map("creado_en")
  actualizadoEn       DateTime     @updatedAt @map("actualizado_en")

  registrosDiarios RegistroDiario[]

  @@map("pilotos")
}

model Unidad {
  id                Int             @id @default(autoincrement())
  numeroUnidad      String          @unique @map("numero_unidad") @db.VarChar(20)
  placa             String          @unique @db.VarChar(20)
  marca             String          @db.VarChar(50)
  modelo            String          @db.VarChar(50)
  anio              Int
  tipoCombustible   TipoCombustible @map("tipo_combustible")
  kilometrajeActual Int             @map("kilometraje_actual")
  intervaloMantenimientoKm Int? @map("intervalo_mantenimiento_km")
  proximoMantenimientoKm   Int? @map("proximo_mantenimiento_km")
  estado            EstadoUnidad    @default(DISPONIBLE)
  observaciones     String?
  creadoEn          DateTime        @default(now()) @map("creado_en")
  actualizadoEn     DateTime        @updatedAt @map("actualizado_en")

  registrosDiarios RegistroDiario[]
  mantenimientos   Mantenimiento[]
  gastos           Gasto[]

  @@map("unidades")
}

enum EstadoRegistroDiario {
  PENDIENTE_COMBUSTIBLE
  COMPLETADO
}

model RegistroDiario {
  id                 Int                  @id @default(autoincrement())
  pilotoId           Int                  @map("piloto_id")
  unidadId           Int                  @map("unidad_id")
  fecha              DateTime             @db.Date
  kilometrajeInicial Int                  @map("kilometraje_inicial")
  kilometrajeFinal   Int                  @map("kilometraje_final")
  montoLiquidado     Decimal              @map("monto_liquidado") @db.Decimal(12, 2)
  estado             EstadoRegistroDiario @default(PENDIENTE_COMBUSTIBLE)
  observaciones      String?
  creadoEn           DateTime             @default(now()) @map("creado_en")
  actualizadoEn      DateTime             @updatedAt @map("actualizado_en")

  piloto            Piloto             @relation(fields: [pilotoId], references: [id])
  unidad            Unidad             @relation(fields: [unidadId], references: [id])
  cargasCombustible CargaCombustible[]

  @@unique([pilotoId, fecha], map: "uq_registros_diarios_piloto_fecha")
  @@unique([unidadId, fecha], map: "uq_registros_diarios_unidad_fecha")
  @@index([fecha])
  @@index([pilotoId])
  @@index([unidadId])
  @@map("registros_diarios")
}

model CargaCombustible {
  id               Int      @id @default(autoincrement())
  registroDiarioId Int      @map("registro_diario_id")
  monto            Decimal  @db.Decimal(12, 2)
  galones          Decimal  @db.Decimal(10, 3)
  precioGalon      Decimal  @map("precio_galon") @db.Decimal(10, 2)
  creadoEn         DateTime @default(now()) @map("creado_en")

  registroDiario RegistroDiario @relation(fields: [registroDiarioId], references: [id], onDelete: Cascade)

  @@index([registroDiarioId])
  @@map("cargas_combustible")
}

enum EstadoMantenimiento {
  EN_PROCESO
  FINALIZADO
}

model Mantenimiento {
  id            Int                 @id @default(autoincrement())
  unidadId      Int                 @map("unidad_id")
  fechaInicio   DateTime            @map("fecha_inicio") @db.Date
  fechaFin      DateTime?           @map("fecha_fin") @db.Date
  kilometraje   Int
  descripcion   String
  costo         Decimal             @db.Decimal(12, 2)
  estado        EstadoMantenimiento @default(EN_PROCESO)
  creadoEn      DateTime            @default(now()) @map("creado_en")
  actualizadoEn DateTime            @updatedAt @map("actualizado_en")

  unidad Unidad @relation(fields: [unidadId], references: [id])

  @@index([unidadId])
  @@index([estado])
  @@map("mantenimientos")
}
enum TipoGasto {
  REPUESTOS_MENORES
  PINCHAZO
}
model Gasto {
  id          Int       @id @default(autoincrement())
  unidadId    Int       @map("unidad_id")
  fecha       DateTime  @db.Date
  tipo        TipoGasto
  descripcion String?
  monto       Decimal   @db.Decimal(12, 2)
  creadoEn    DateTime  @default(now()) @map("creado_en")

  unidad Unidad @relation(fields: [unidadId], references: [id])

  @@index([unidadId])
  @@index([fecha])
  @@index([tipo])
  @@map("gastos")
}
